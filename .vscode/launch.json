{
  // Run and Debug panel (Ctrl+Shift+D): pick a configuration, then F5.
  // Set breakpoints by clicking left of a line number. While paused, hover variables
  // or use the Debug Console to run code (e.g. `await page.title()`).
  "version": "0.2.0",
  "configurations": [
    {
      // The test website on http://localhost:3000. Breakpoints in dummy-site/server.ts work too.
      "name": "Dummy site",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dummy-site/server.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Scripted stand-in for an AI agent: starts the MCP server and drives admin + user through it.
      // Needs the dummy site running. Breakpoints work in demo-agent.ts (the server runs as a child process).
      "name": "Demo agent (visible browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/mcp/demo-agent.ts",
      "args": ["--visible"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      // Runs whichever .ts file is open in the editor, e.g. a quick Playwright experiment.
      "name": "Current file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
